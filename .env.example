# --------------------------------------
# Configuración general
# --------------------------------------
PORT=3000
NODE_ENV=development
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=3600
UPLOAD_DIR=./uploads

# --------------------------------------
# Render / despliegue
# --------------------------------------
# En Render, usa valores de producción como:
# PORT=10000
# NODE_ENV=production
# JWT_SECRET=una_clave_muy_segura
# JWT_EXPIRES_IN=3600
# UPLOAD_DIR=./uploads

# --------------------------------------
# Supabase / PostgreSQL (para futura integración real)
# --------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# --------------------------------------
# Vercel Blob (para comprobantes y fotos)
# --------------------------------------
BLOB_READ_WRITE_TOKEN=tu_token_de_vercel_blob

# --------------------------------------
# Opcional: configuración adicional
# --------------------------------------
API_BASE_URL=http://localhost:3000
ADMIN_EMAIL=admin@albergue.pe
ADMIN_PASSWORD=Admin12345
